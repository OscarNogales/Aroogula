# Copy this file to .env and fill in your own credentials.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
GROQ_API_KEY=
FMP_API_KEY=
# SEC EDGAR requires an identifying name + contact email. This is not a secret.
SEC_EDGAR_IDENTITY=Your Name you@example.com

# Optional: absolute path to an Ollama executable if `ollama` is not on PATH.
OLLAMA_APP_PATH=
